# ~/.config/zsh/zshrc

source $HOME/.config/sh/shrc

[[ -o interactive ]] || return

#:modules

typeset -U fpath # no duplicates
if test -d $HOME/.config/zsh/zfunctions ; then
    fpath=($HOME/.config/zsh/zfunctions $fpath)
    for zf in $(find $HOME/.config/zsh/zfunctions) ; do
        autoload -Uz ${zf:t:r}
    done
fi

#:sources

for rc in $(find $HOME/.config/zsh -name '*.zsh') ; do
    source $rc
done

# EOF
