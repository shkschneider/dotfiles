{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { // or null
    //"color": { "1": "yellow", },
    "separate": false, // above?
    "type": "small",
    "padding": { "top": 1, "left": 1, "right": 1 },
  },
  "display": {
    //"color": { "keys": "yellow" },
    "brightColor": true,
    "separator": "  ",
  },
  "modules": [
    {
        "type": "command",
        "key": "Machine",
        "text": "~/.local/share/fastfetch/scripts/machine.sh",
    },
    { "type": "os", "key": "System", "format": "{2} ({8}{11})" },
    { "type": "kernel", "format": "{1} {2} ({4})" },
    {
        "type": "command",
        "key": "Packages",
        "text": "~/.local/share/fastfetch/scripts/packagemanager.sh",
    },
    {
        "type": "command",
        "key": "Init",
        "text": "~/.local/share/fastfetch/scripts/init.sh",
    },
    { "type": "wm", "key": "Desktop", "format": "{1} ({3})" },
    { "type": "terminal", "format": "{1} {6}" },
    { "type": "terminalfont", "key": "Font", "format": "{2} {3}" },
    { "type": "shell", "format": "{1} {4}" },
    { "type": "colors", "symbol": "square" },
    //{ "type": "colors", "symbol": "circle|square" },
  ]
}
