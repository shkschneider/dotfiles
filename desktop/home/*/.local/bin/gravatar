#!/usr/bin/env bash

email="${1:-$EMAIL}"
[[ -z "$email" ]] && command -v git >/dev/null && email="$(git config user.email 2>/dev/null)"
[[ -n "$email" ]] || exit 1

command -v openssl >/dev/null || exit 1
email="$(echo -- "$email" | openssl dgst -md5 -r | cut -d' ' -f1)"
size="${2:-1024}"
echo "$email $size"
command -v wget >/dev/null && \
    wget --quiet "https://gravatar.com/avatar/$email?s=$size" -O "$email.png"
echo "$email.png"

# EOF
