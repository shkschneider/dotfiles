#!/usr/bin/env bash
# ~/.local/bin/desktops

desktops=()
for location in "$HOME/.local/share" "/usr/share" ; do
    while read -r desktop ; do
        desktops+=( "$desktop" )
    done < <(find "$location" -type f,l -name '*.desktop' 2>/dev/null)
done

echo "${desktops[@]}" | tr ' ' "\n" | sort --uniq

# EOF
