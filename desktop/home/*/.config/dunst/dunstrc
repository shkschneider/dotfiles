# ~/.config/dunst/dunstrc
# dunstctl reload ; for l in low normal critical ; do notify-send -u $l "$l" ; done
# dunstctl close-all

# @theme@
[global]
corner_radius = 8
font = Symbols Nerd Font Mono, Outfit, JetBrains Mono, Hack, monospace 11
frame_width = 1
gap_size = 2
hide_duplicate_count = false
max_icon_size = 16
min_icon_size = 8
offset = (7, 8)
origin = top-right
padding = 4
progress_bar_corner_radius = 4
sort = update

# @theme@
[urgency_low]
background = "#333333"
foreground = "#eeeeee"
frame_color = "#eeeeee"
timeout = 1

# @theme@
[urgency_normal]
background = "#333333"
foreground = "#eeeeee"
frame_color = "#1793d1"
timeout = 3

# @theme@
[urgency_critical]
background = "#333333"
foreground = "#eeeeeeaa"
frame_color = "#ff6188"
timeout = 0

# EOF
