{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "spacing": 0,
    "height": 42,
    "modules-left": [
        "custom/logo",
        "custom/separator",
        "hyprland/workspaces",
        "custom/separator",
        "hyprland/window",
    ],
    "modules-center": [
    ],
    "modules-right": [
        "tray",
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "disk",
        "network",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "backlight",
        "battery",
        "clock",
        "custom/separator",
        "custom/power",
    ],
    "custom/separator": {
        "format": "|",
    },
    "custom/logo": {
        "format": " ",
        "tooltip": false,
        "on-click": "tofi -drun",
    },
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "󱓻",
            "urgent": "󱓻",
        },
        "persistent-workspaces": {},
    },
    "hyprland/window": {
        "expand": true,
        "rewrite": {
            "[^\\u0000-\\u007F]+": "",
        },
    },
    "tray": {
        "expand": true,
        "spacing": 10,
    },
    "cpu": {
        "format": "  {usage}%",
    },
    "memory": {
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({avail:0.1f}G)",
    },
    "disk": {
        "format": "  {percentage_used}%",
        "tooltip-format": "{path}: {specific_used:0.1f}G / {specific_total:0.1f}G ({specific_free:0.1f}G)",
        "unit": "GB",
    },
    "network": {
        "format-wifi" : "{icon}  {signalStrength}%",
        "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"],
        "format-ethernet": "󰀂",
        // "format-alt" : "󱛇",
        "format-disconnected" : "󰖪",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "tooltip-format-ethernet": "{ipaddr}",
        "tooltip-format-disconnected": "Offline",
        "on-click": "rfkill unblock wifi",
        "nospacing": 1,
    },
    "bluetooth": {
        "format": "  {status}",
        "format-connected": "  {device_alias}",
        "format-connected-battery": "  {device_alias} ({device_battery_percentage}%)",
        "format-no-controller": "  —",
        "format-disabled": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n{device_enumerate}",
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "󰂰",
        "tooltip": false,
        "nospacing": 1,
        "format-muted": "󰝟  —",
        "format-icons": {
            "headphone": "",
            "default": ["󰖀","󰕾",""],
        },
        "on-click": "pamixer -t",
        "scroll-step": 5,
    },
    "backlight": {
        "format": "  {percent}%",
        "tooltip": false,
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-icons": {
            "charging": [
                "󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"
            ],
            "default": [
                "󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"
            ],
        },
        "format-full": "  100%",
        "states": {
            "warning": 50,
            "critical": 25
        },
        "tooltip": "{time}",
    },
    "clock": {
        "tooltip-format": "{calendar}",
        "format-alt": "{:%d/%m/%Y}",
        "format": "{:%H:%M}",
    },
    "custom/power": {
        "format": "󰤆",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "logout": "hyprctl dispatch exit",
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot",
        },
    },
}
