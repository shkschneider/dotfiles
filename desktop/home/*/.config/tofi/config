# ~/.config/tofi/config

horizontal = true
anchor = top
width = 99%
height = 30
exclusive-zone = -1

ascii-input = true
auto-accept-single = false
clip-to-padding = true
hide-cursor = true
hide-input = false
history = false
matching-algorithm = fuzzy
multi-instance = false
output = ""
placeholder-text = "_"
prompt-text = " "
require-match = true
result-spacing = 4
scale = true
text-cursor = true
#num-results = 1

# @theme@
background-color = #333333
border-color = #1793d1
border-width = 1
corner-radius = 8
font-size = 11
input-background = #333333
input-color = #1793d1
margin-bottom = 0
margin-left = 0
margin-right = 0
margin-top = 6
outline-color = #1793d1
outline-width = 0
padding-bottom = 0
padding-left = 0
padding-right = 0
padding-top = 2
selection-color = #1793d1
text-color = #eeeeee
text-cursor-color = #1793d1
text-cursor-corner-radius = 1px
text-cursor-style = block

# EOF
