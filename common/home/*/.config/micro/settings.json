{
    "autoclose": false,
    "backup": false,
    "backupdir": "~/.cache/micro",
    "basename": true,
    "clipboard": "external",
    "diff": true,
    "diffgutter": true,
    "font": "Symbols Nerd Font Mono, JetBrains Mono NL, monospace",
    "hlsearch": true,
    "hltaberrors": true,
    "hltrailingws": true,
    "ignorecase": false,
    "matchbracestyle": "underline",
    "mkparents": true,
    "relativeruler": true,
    "rmtrailingws": true,
    "savecursor": true,
    "savehistory": false,
    "saveundo": true,
    "softwrap": true,
    "status": false,
    "statusformatl": " $(shk.StatusLeft) ",
    "statusformatr": " $(shk.StatusRight) ",
    "tabstospaces": true,
    "wordwrap": true
}
