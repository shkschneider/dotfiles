#!/usr/bin/env bash

(( $# == 0 )) && set -- "$(cat /dev/stdin)"

for src in "$@" ; do
    src="$(realpath -- "$src")"
    if [[ ! -e "$src" ]] ; then
        echo "path does not exist: $src" >&2
        continue
    fi
    dirname="${src%/*}"
    basename="${src##*/}"
    case "$basename" in
        .*) dst="$dirname/${basename#.}" ;;
        * ) dst="$dirname/.${basename}" ;;
    esac
    if [[ -e "$dst" ]] ; then
        echo "path exists: $dst" >&2
        continue
    fi
    if [[ "$src" == "$dst" ]] ; then
        echo "paths are the same: $src" >&2
        continue
    fi
    mv -v -- "$src" "$dst"
done

# EOF
