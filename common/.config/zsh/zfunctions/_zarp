#compdef zarp

for z in $(cat "$HOME/.config/zsh/.zarp" 2>/dev/null | grep -v " $PWD$" | cut -d' ' -f1) ; do
  compadd -- "$z"
done

local z ; z=$(cat "$HOME/.config/zsh/.zarp" 2>/dev/null | grep " $PWD$" | cut -d' ' -f1)
if [ -n "$z" ] ; then
  compadd -- "-$z"
  _message -- "-$z"
else
  _message -- "+${PWD:t:l}"
fi

# EOF
