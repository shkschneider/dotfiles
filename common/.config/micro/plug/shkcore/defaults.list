cd # change working directory
hsplit # horizontal split bottom
open # new file
pwd # print working directory
reload # configuration files
reopen # current file from disk
retab # convert indentation spaces tabs
set ruler false # hide line numbers
set ruler true # show line numbers
set softwrap true # soft wrap
set wordwrap true # soft wrap
tab # open new tab
term # open terminal
textfilter awk '{print $2 " " $1}' # swap words
textfilter base64 --decode # decode
textfilter base64 # encode
textfilter fold -s -w 79 # hard wrap
textfilter grep -oP '\S+://\S+' # extract url
textfilter grep -oP '\w+@\w+' # extract email
textfilter grep -v '^\s*$' # remove empty lines
textfilter nl # number lines
textfilter sort -nr # sort numeric descending
textfilter sort -n # sort numeric ascending
textfilter sort -r # sort alphabethical descending
textfilter sort # sort alphabethical ascending
textfilter sort -u # remove duplicate
textfilter tr '[a-z]' '[A-Z]' # lowercase uppercase
textfilter tr '[A-Z]' '[a-z]' # uppercase lowercase
textfilter tr ' ' ',' # join space comma
textfilter tr '\n' ' ' # join lines
textfilter tr '\n' ',' # join newline comma
textfilter tr ',' '\n' # split join csv to lines
textfilter tr -s ' ' # squeeze space
vsplit # vertical split right
