{
    "autoclose": false,
    "autosu": true,
    "colorscheme": "shk",
    "diffgutter": true,
    "ignorecase": false,
    "mkparents": true,
    "reload": "auto",
    "rmtrailingws": true,
    "savecursor": true,
    "saveundo": true,
    "softwrap": true,
    "statusformatl": " $(filename)$(modified) $(line):$(col)",
    "statusformatr": "$(opt:fileformat) $(opt:encoding) | .$(opt:filetype) ",
    "tabstospaces": true,
    "wordwrap": true
}
